# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FASTAPI_SECRET_KEY=
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=28800
ALLOWED_HOSTS=10.236.173.129,127.0.0.1,localhost
LTI13_ALLOW_INSECURE_HTTP=false

# Must point to the same Mongo database as prime_dashboard.
MONGO_URL=mongodb://mongo:27017
APP_PATH_PREFIX=mathquizgen

# Use the same LTI 1.3 private key as prime_dashboard. Keep it outside Git.
LTI13_PRIVATE_KEY_FILE=/run/secrets/lti13_private.pem
LTI13_KEY_ID=
# Required in production and must include the configured APP_PATH_PREFIX.
LTI13_PUBLIC_BASE_URL=

# Existing LTI 1.1 registrations remain supported.
LTI_URL=http://10.236.173.129:13862/mathquizgen/lti/login
MAX_GENERATION=10
LTI_CONSUMER_KEY_1=
LTI_SHARED_SECRET_1=

OPENAI_API_KEY=
GEMINI_API_KEY=
BOOKROLL_DATABASE_HOST_1=
BOOKROLL_DATABASE_USER_1=
BOOKROLL_DATABASE_PASS_1=
